mainmenu "RIOSE virtual cattle tag"
source "Kconfig.zephyr"

menu "RIOSE virtual cattle tag"

config TAG_ID
	int "32-bit tag identity"
	range 0 2147483647
	default 1

config TAG_BATTERY_MV
	int "Configured battery voltage in millivolts"
	range 0 65535
	default 3000

config TAG_RF_FREQUENCY_HZ
	int "Sub-GHz radio frequency in Hz"
	range 150000000 960000000
	default 915000000

config TAG_TX_POWER_DBM
	int "SX1262 TX power in dBm"
	range -9 22
	default 10

config TAG_STRUCTURED_TRACE
	bool "Emit structured firmware trace records"
	default y
	help
	  Enable the optional SIMULATED_TRACE console sink. Disabling this option
	  removes structured trace output without changing firmware policy.

config TAG_NATIVE_SIM_INJECT_IMU_FAILURE
	bool "Inject one native_sim IMU error for trace recovery tests"
	depends on BOARD_NATIVE_SIM
	default n
	help
	  Make the native_sim test fail one IMU read, then verify the firmware
	  emits ERROR/RECOVERY records and completes a later radio cycle.

endmenu
